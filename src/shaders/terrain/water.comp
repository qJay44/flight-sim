#version 460 core

#include "common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;

layout(rgba16f, binding = 0) writeonly uniform image2D imgOutput;

struct Config {
  float initAmplitude;
  float initFrequency;
  float gain;
  float lacunarity;
  float speed;
  int octaves;
};

layout(std140, binding = 0) uniform ConfigBlock {
  Config cfg;
};

uniform float u_time;

void main() {
  ivec2 texCoord = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(imgOutput);
  if (texCoord.x >= size.x || texCoord.y >= size.y)
    return;

  // Map texCoord to 0..1 UV
  vec2 uv = vec2(texCoord) / vec2(size - 1);

  float height = 0.0;
  vec2 slope = vec2(0.0);

  float amp = cfg.initAmplitude;
  float freq = cfg.initFrequency;

  // Octaves of waves (Gerstner Approximation)
  for (int i = 0; i < cfg.octaves; i++) {
    vec2 dir = normalize(vec2(cos(float(i)), sin(float(i)))); // Random direction
    float phase = cfg.speed * u_time * sqrt(9.8 * freq); // Deep water dispersion
    float tileableFreq = floor(freq) * TAU;
    float theta = dot(dir, uv * 10.0) * tileableFreq + phase;

    // Accumulate Height
    height += sin(theta) * amp;

    // Accumulate Normal (Slope)
    float d = cos(theta) * amp * floor(freq);
    slope += dir * d;

    amp *= cfg.gain;
    freq *= cfg.lacunarity;
  }

  // Normal reconstruction
  vec3 normal = normalize(vec3(-slope.x, -slope.y, 2.0));

  // Store: RGB = Normal, A = Height
  imageStore(imgOutput, texCoord, vec4(normal * 0.5 + 0.5, height));
}

