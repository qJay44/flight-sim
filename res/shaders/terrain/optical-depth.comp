#version 460 core

#include "../atmosphere.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(rg32f, binding = 0) writeonly uniform image2D imageWrite;

uniform vec3 u_planetCenter;
uniform float u_planetRadius;
uniform float u_atmosphereRadius;
uniform float u_densityFalloffR;
uniform float u_densityFalloffM;
uniform int u_opticalDepthPoints;

void main() {
  g_atmosphere.planetCenter            = u_planetCenter;
  g_atmosphere.atmosphereRadius        = u_atmosphereRadius;
  g_atmosphere.densityFalloffR         = u_densityFalloffR;
  g_atmosphere.densityFalloffM         = u_densityFalloffM;
  g_atmosphere.planetRadius            = u_planetRadius;

  ivec2 texCoord = ivec2(gl_GlobalInvocationID.xy);
  ivec2 imgSize = imageSize(imageWrite);

  vec2 uv = vec2(texCoord) / imgSize;
  float heightNorm = uv.y;
  float angle = uv.x * PI;
  vec2 dir = vec2(sin(angle), cos(angle));
  float y = uv.x * 2.f - 1.f;
  float x = sin(acos(y));
  dir = vec2(x, y);

  vec2 inPoint = vec2(0.f, mix(u_planetRadius, u_atmosphereRadius, heightNorm));
  Ray ray = Ray(vec3(inPoint + dir * 0.01f, 0.f), vec3(dir, 0.f));

  float dstThroughAtmosphere = raySphere(u_planetCenter, u_atmosphereRadius, ray).distThroughSphere;

  vec2 outPoint = inPoint + dir * dstThroughAtmosphere;
  vec2 outScattering = _Atmosphere_opticalDepthTrace(ray, dstThroughAtmosphere, u_opticalDepthPoints);

  imageStore(imageWrite, texCoord, vec4(outScattering, 0.f, 1.f));
}

